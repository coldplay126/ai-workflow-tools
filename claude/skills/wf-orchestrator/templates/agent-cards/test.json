{
  "name": "phase-test",
  "version": "1.2.0",
  "description": "Runs regression tests and acceptance scenario validation. Produces test report with pass/fail results and manual sign-off checklist.",

  "agent": {
    "definition": "claude/agents/happy-path-tester.md",
    "name": "happy-path-tester"
  },

  "cmux": {
    "worker": "worker-test",
    "provider": "codex"
  },

  "capabilities": {
    "file_access": true,
    "file_write": false,
    "git_access": false,
    "sandbox_modes": ["workspace-write"],
    "execution_modes": ["inline", "delegated"],
    "protocol_hint": { "recommended_mode": "precise", "reason": "테스트 커버리지 정밀 분석에 최적" }
  },

  "skills": [
    { "id": "regression-test", "description": "Executes test_command and captures pass/fail/skip counts" },
    { "id": "acceptance-test", "description": "Validates spec.md acceptance scenarios against implementation and test code" },
    { "id": "test-bootstrap", "description": "Generates test skeletons from acceptance scenarios (optional)" }
  ],

  "input": {
    "required_artifacts": [
      { "key": "spec", "path": "artifacts/spec.md", "embed_for_stateless": true },
      { "key": "tasks", "path": "artifacts/tasks.md", "embed_for_stateless": true },
      { "key": "manifest", "path": "manifest.json", "embed_for_stateless": true }
    ],
    "required_state": {
      "gates": {
        "G5": { "passed": true }
      }
    },
    "optional_context": [
      { "key": "verification_report", "path": "artifacts/verification-report.md" }
    ],
    "database": {
      "stage": "test",
      "profile_artifact": "manifest.json",
      "decision_artifact": "artifacts/database-decision.json",
      "evidence_artifact": "artifacts/database-validation-evidence.json",
      "production_schema_required": true
    }
  },

  "output": {
    "artifacts": [
      { "key": "test_report", "path": "artifacts/test-report.md", "format": "markdown", "required": true },
      { "key": "database_validation_evidence", "path": "artifacts/database-validation-evidence.json", "format": "json", "required": false, "required_when_database_signal": true }
    ],
    "structured_result": {
      "conclusion": "PASS|FAIL",
      "findings": [{ "severity": "CRITICAL|HIGH|MEDIUM|LOW", "category": "hp_*", "location": "string", "description": "string", "suggestion": "string" }],
      "evidence": [],
      "risks": [],
      "action_items": [],
      "phase_metrics": {
        "regression": {
          "pass": "int",
          "fail": "int",
          "skip": "int",
          "total": "int",
          "failed_tests": ["string"]
        },
        "acceptance": {
          "auto_verified": "int",
          "code_review": "int",
          "manual_pending": "int",
          "total": "int"
        }
      }
    }
  },

  "gate": {
    "id": "G6",
    "pass_conditions": [
      "suites.failed == 0",
      "regressions.count == 0",
      "acceptance.passed == acceptance.total",
      "coverage.percentage >= 70"
    ],
    "database_conditions": [
      "database.production_schema",
      "database.local_test"
    ],
    "_pass_conditions_doc": "Worker result schema: { suites: [{passed,failed,...}], regressions: [...], acceptance: {passed,total}, coverage: {percentage} }",
    "on_pass": { "next_phase": "done" },
    "on_fail": {
      "regression_failure": { "next_phase": "impl" }
    }
  },

  "retry": { "max": 3 },
  "hil": false
}
