{
  "name": "phase-approve",
  "version": "1.1.0",
  "description": "Parent-only human approval contract. Presents scope and risk, then requires explicit awf wf approve CLI recording; providers and OMP workers cannot approve.",

  "capabilities": {
    "file_access": true,
    "file_write": false,
    "git_access": true,
    "sandbox_modes": [],
    "execution_modes": ["inline"],
    "protocol_hint": { "recommended_mode": "solo", "reason": "HIL 승인은 단일 에이전트가 적합" }
  },

  "skills": [
    { "id": "scope-summary", "description": "Presents file scope, risk assessment, task count, and read-only OMP evidence for a human decision" },
    { "id": "parent-approval", "description": "Runs awf wf approve only after an explicit human approve, revise, or reject decision" }
  ],

  "input": {
    "required_artifacts": [
      { "key": "spec", "path": "artifacts/spec.md", "embed_for_stateless": false },
      { "key": "plan", "path": "artifacts/plan.md", "embed_for_stateless": false },
      { "key": "tasks", "path": "artifacts/tasks.md", "embed_for_stateless": false },
      { "key": "review_report", "path": "artifacts/review-report.md", "embed_for_stateless": false },
      { "key": "allowed_files", "path": "artifacts/allowed-files.json", "embed_for_stateless": false }
    ],
    "required_state": { "gates": { "G2": { "passed": true } } },
    "optional_context": []
  },

  "output": {
    "artifacts": [
      { "key": "approval", "path": "artifacts/approval.json", "format": "json", "required": true }
    ],
    "structured_result": {
      "decision": "approve|revise|reject",
      "status": "approved|revised|rejected|blocked",
      "scope_hash": "string|null",
      "current_phase": "impl|plan|rejected"
    }
  },

  "gate": {
    "id": "G3",
    "pass_conditions": [
      "user decision == approved",
      "scope_hash computed and stored"
    ],
    "on_pass": { "next_phase": "impl" },
    "on_fail": {
      "revision": { "next_phase": "plan", "creates": "review-feedback.md" },
      "rejected": { "next_phase": null }
    }
  },

  "retry": { "max": 1 },
  "hil": true
}
