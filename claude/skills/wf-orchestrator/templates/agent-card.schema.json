{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WF Phase Agent Card",
  "description": "A2A-inspired agent card defining I/O contract for each workflow phase",
  "type": "object",
  "required": ["name", "version", "description", "input", "output", "gate", "retry", "hil"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Phase skill name (e.g., phase-review)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of what this phase does"
    },
    "agent": {
      "type": "object",
      "description": "Agent definition reference. Points to claude/agents/*.md for behavioral instructions.",
      "properties": {
        "definition": { "type": "string", "description": "Path to agent definition file (e.g., claude/agents/artifact-reviewer.md)" },
        "name": { "type": "string", "description": "Agent name matching the definition's frontmatter name" }
      }
    },
    "cmux": {
      "type": "object",
      "description": "cmux-agent worker mapping for multi-session execution.",
      "properties": {
        "worker": { "type": "string", "description": "cmux worker name (e.g., worker-review)" },
        "provider": { "type": "string", "description": "AI CLI provider (e.g., codex, claude, gemini)" }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "file_access": { "type": "boolean", "description": "Whether the phase needs to read project files" },
        "file_write": { "type": "boolean", "description": "Whether the phase needs to write project files" },
        "git_access": { "type": "boolean", "description": "Whether the phase needs git operations" },
        "sandbox_modes": {
          "type": "array",
          "items": { "enum": ["read-only", "workspace-write", "danger-full-access"] }
        },
        "execution_modes": {
          "type": "array",
          "items": { "enum": ["inline", "delegated"] },
          "description": "Supported execution modes. 'inline' = SKILL.md read by host LLM. 'delegated' = task sent to external worker."
        },
        "dual_strategy": {
          "enum": ["parallel_evaluate", "generate_then_validate", "implement_then_review"],
          "default": "parallel_evaluate",
          "description": "How dual mode operates. 'parallel_evaluate' = both LLMs evaluate independently, merge results (review/verify). 'generate_then_validate' = Primary generates, Secondary pre-validates (plan/test). 'implement_then_review' = Primary implements, Secondary reviews git diff post-completion (impl)."
        },
        "protocol_hint": {
          "type": "object",
          "description": "Suggests optimal Multi-Agent Protocol mode for ad-hoc queries during this phase",
          "properties": {
            "recommended_mode": { "enum": ["solo", "precise", "cross", "critical"] },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "input": {
      "type": "object",
      "properties": {
        "required_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "path"],
            "properties": {
              "key": { "type": "string" },
              "path": { "type": "string", "description": "Relative to .workflow/" },
              "embed_for_stateless": { "type": "boolean", "default": true, "description": "If true, embed full content in task message for workers without file access" }
            }
          }
        },
        "required_state": {
          "type": "object",
          "description": "State preconditions that must be true before this phase can execute",
          "properties": {
            "gates": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "passed": { "type": "boolean" }
                }
              }
            }
          }
        },
        "database": {
          "type": "object",
          "description": "Signal-gated database validation inputs. Paths are relative to .workflow/.",
          "required": [
            "stage",
            "profile_artifact",
            "decision_artifact",
            "evidence_artifact",
            "production_schema_required"
          ],
          "additionalProperties": false,
          "properties": {
            "stage": { "enum": ["plan", "verify", "test"] },
            "profile_artifact": { "type": "string" },
            "decision_artifact": { "type": "string" },
            "evidence_artifact": { "type": "string" },
            "production_schema_required": { "const": true }
          }
        },
        "planning_options": {
          "type": "object",
          "description": "Canonical planning-options policy and decision artifact inputs. Paths are relative to .workflow/.",
          "required": ["policy", "artifact"],
          "additionalProperties": false,
          "properties": {
            "policy": { "type": "string" },
            "artifact": { "type": "string" }
          }
        },
        "optional_context": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": { "type": "string" },
              "path": { "type": ["string", "null"] },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "path", "format", "required"],
            "properties": {
              "key": { "type": "string" },
              "path": { "type": "string" },
              "format": { "enum": ["markdown", "json"] },
              "required": { "type": "boolean", "default": true },
              "required_when_database_signal": {
                "type": "boolean",
                "default": false
              },
              "required_when_planning_options": {
                "type": "boolean",
                "default": false
              }
            },
            "additionalProperties": false
          }
        },
        "structured_result": {
          "type": "object",
          "description": "JSON schema for the structured result that delegated workers must return"
        }
      }
    },
    "gate": {
      "type": "object",
      "required": ["id", "pass_conditions", "on_pass"],
      "properties": {
        "id": {
          "type": ["string", "null"],
          "pattern": "^G[1-6]$",
          "description": "G1-G6 for gated phases; null only for the terminal done phase"
        },
        "pass_conditions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Human-readable conditions. All must be true for gate to pass."
        },
        "database_conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "database.signal",
              "database.risk_class",
              "database.decision",
              "database.production_schema",
              "database.equivalence",
              "database.integrity",
              "database.query_plan",
              "database.migration",
              "database.rollback",
              "database.local_test"
            ]
          },
          "description": "Mandatory machine-evaluated database conditions when a database signal is present."
        },
        "planning_options_conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "planning_options.artifact",
              "planning_options.shape",
              "planning_options.selection",
              "planning_options.recommendation",
              "planning_options.materiality",
              "planning_options.provenance"
            ]
          },
          "description": "Mandatory machine-evaluated Planning Options conditions for phase-plan."
        },
        "on_pass": {
          "type": "object",
          "required": ["next_phase"],
          "properties": {
            "next_phase": { "type": ["string", "null"] }
          }
        },
        "on_fail": {
          "type": "object",
          "description": "Failure routing by severity/type",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "next_phase": { "type": ["string", "null"] },
              "prompt_user": { "type": "boolean" },
              "creates": { "type": "string" },
              "recommended_action": {
                "enum": ["continue", "replan", "abort", "user_decision"]
              }
            }
          }
        }
      }
    },
    "retry": {
      "type": "object",
      "properties": {
        "max": { "type": "integer" }
      }
    },
    "hil": {
      "type": "boolean",
      "description": "If true, this phase requires human-in-the-loop interaction and cannot be fully delegated"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "name": { "const": "phase-plan" } }, "required": ["name"] },
      "then": {
        "properties": {
          "input": {
            "required": ["database", "planning_options"],
            "properties": {
              "database": {
                "properties": { "stage": { "const": "plan" } }
              },
              "planning_options": {
                "properties": {
                  "policy": { "const": "manifest.planning_options.required" },
                  "artifact": { "const": "artifacts/planning-options.json" }
                }
              }
            }
          },
          "gate": {
            "required": ["database_conditions", "planning_options_conditions"],
            "properties": {
              "database_conditions": {
                "const": [
                  "database.signal",
                  "database.risk_class",
                  "database.decision",
                  "database.production_schema"
                ]
              },
              "planning_options_conditions": {
                "const": [
                  "planning_options.artifact",
                  "planning_options.shape",
                  "planning_options.selection",
                  "planning_options.recommendation",
                  "planning_options.materiality",
                  "planning_options.provenance"
                ]
              },
              "on_fail": {
                "required": ["decision_selection_required"],
                "properties": {
                  "decision_selection_required": {
                    "const": {
                      "next_phase": "plan",
                      "prompt_user": true,
                      "recommended_action": "user_decision"
                    }
                  }
                }
              }
            }
          },
          "output": {
            "required": ["artifacts"],
            "properties": {
              "artifacts": {
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "required": ["key", "path", "format", "required", "required_when_database_signal"],
                      "properties": {
                        "key": { "const": "database_decision" },
                        "path": { "const": "artifacts/database-decision.json" },
                        "format": { "const": "json" },
                        "required": { "const": false },
                        "required_when_database_signal": { "const": true }
                      }
                    }
                  },
                  {
                    "contains": {
                      "type": "object",
                      "required": ["key", "path", "format", "required", "required_when_database_signal"],
                      "properties": {
                        "key": { "const": "database_validation_evidence" },
                        "path": { "const": "artifacts/database-validation-evidence.json" },
                        "format": { "const": "json" },
                        "required": { "const": false },
                        "required_when_database_signal": { "const": true }
                      }
                    }
                  },
                  {
                    "contains": {
                      "const": {
                        "key": "planning_options",
                        "path": "artifacts/planning-options.json",
                        "format": "json",
                        "required": false,
                        "required_when_planning_options": true
                      }
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "const": {
                        "key": "planning_provenance",
                        "path": "artifacts/planning-provenance.json",
                        "format": "json",
                        "required": false,
                        "required_when_planning_options": true
                      }
                    },
                    "minContains": 1,
                    "maxContains": 1
                  }
                ],
                "items": {
                  "allOf": [
                    {
                      "if": {
                        "properties": { "key": { "const": "planning_options" } },
                        "required": ["key"]
                      },
                      "then": {
                        "const": {
                          "key": "planning_options",
                          "path": "artifacts/planning-options.json",
                          "format": "json",
                          "required": false,
                          "required_when_planning_options": true
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": { "key": { "const": "planning_provenance" } },
                        "required": ["key"]
                      },
                      "then": {
                        "const": {
                          "key": "planning_provenance",
                          "path": "artifacts/planning-provenance.json",
                          "format": "json",
                          "required": false,
                          "required_when_planning_options": true
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "key": {
                            "not": {
                              "enum": ["planning_options", "planning_provenance"]
                            }
                          }
                        },
                        "required": ["key"]
                      },
                      "then": {
                        "not": { "required": ["required_when_planning_options"] }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "key": {
                            "not": {
                              "enum": [
                                "database_decision",
                                "database_validation_evidence"
                              ]
                            }
                          }
                        },
                        "required": ["key"]
                      },
                      "then": {
                        "not": { "required": ["required_when_database_signal"] }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "name": { "const": "phase-verify" } }, "required": ["name"] },
      "then": {
        "properties": {
          "input": {
            "required": ["database"],
            "properties": {
              "database": {
                "properties": { "stage": { "const": "verify" } }
              }
            }
          },
          "gate": {
            "required": ["database_conditions"],
            "properties": {
              "database_conditions": {
                "const": [
                  "database.production_schema",
                  "database.risk_class",
                  "database.equivalence",
                  "database.integrity",
                  "database.query_plan",
                  "database.migration",
                  "database.rollback"
                ]
              }
            }
          },
          "output": {
            "required": ["artifacts"],
            "properties": {
              "artifacts": {
                "contains": {
                  "type": "object",
                  "required": ["key", "path", "format", "required", "required_when_database_signal"],
                  "properties": {
                    "key": { "const": "database_validation_evidence" },
                    "path": { "const": "artifacts/database-validation-evidence.json" },
                    "format": { "const": "json" },
                    "required": { "const": false },
                    "required_when_database_signal": { "const": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "name": { "const": "phase-test" } }, "required": ["name"] },
      "then": {
        "properties": {
          "input": {
            "required": ["database"],
            "properties": {
              "database": {
                "properties": { "stage": { "const": "test" } }
              }
            }
          },
          "gate": {
            "required": ["database_conditions"],
            "properties": {
              "database_conditions": {
                "const": [
                  "database.production_schema",
                  "database.risk_class",
                  "database.local_test"
                ]
              }
            }
          },
          "output": {
            "required": ["artifacts"],
            "properties": {
              "artifacts": {
                "contains": {
                  "type": "object",
                  "required": ["key", "path", "format", "required", "required_when_database_signal"],
                  "properties": {
                    "key": { "const": "database_validation_evidence" },
                    "path": { "const": "artifacts/database-validation-evidence.json" },
                    "format": { "const": "json" },
                    "required": { "const": false },
                    "required_when_database_signal": { "const": true }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
